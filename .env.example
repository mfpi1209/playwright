# Admin VTEX (obrigatório para Playwright; também aceita VTEX_ADMINS="email:senha|email2:senha2")
VTEX_ADMIN_EMAIL=fabio.boas50@polo.cruzeirodosul.edu.br
VTEX_ADMIN_PASSWORD=Eduit777

# Pós-graduação: 1 = conclui só no VTEX (sem SIAA/boleto). 0 = fluxo completo. Na API, o padrão é 1.
POS_SKIP_PAGAMENTO_SIAA=1

# VTEX: 1 = usar alias +sufixo no email do checkout (ex: ana+pos123@gmail.com) para evitar
# o bloqueio de "email já existe" que exige código passwordless. Default: 0 (usa email original).
# ATENÇÃO: só habilite quando o CPF também for novo OU se a conta antiga foi removida do VTEX,
# pois o CPF é chave única de cliente B2C e gera conflito ao tentar criar conta nova com mesmo CPF.
VTEX_USE_EMAIL_ALIAS=0

# Kommo CRM - Login para Upload de Arquivos
KOMMO_EMAIL=adm@eduit.com.br
KOMMO_PASSWORD=sua_senha_aqui
